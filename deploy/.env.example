# 基础设施编排变量示例
#
# 用法：
#   cp deploy/.env.example deploy/.env
#   然后按需修改。此文件只服务于 docker-compose.infra.yml（容器侧参数），
#   应用自身的配置在 backend/.env（参见 backend/config/.env.development.example）。
#
# ⚠️ 本文件的凭证仅用于开发。交付形态（deploy_mode=prod）下若沿用默认值，
#    应用启动校验会直接拒绝启动。

# ── PostgreSQL ────────────────────────────────────────────────────────
POSTGRES_USER=medguide
POSTGRES_PASSWORD=medguide
POSTGRES_DB=medguide
POSTGRES_PORT=5432

# ── Redis ─────────────────────────────────────────────────────────────
REDIS_PORT=6379

# ── MinIO ─────────────────────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=medguide
