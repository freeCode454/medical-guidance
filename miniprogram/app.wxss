page {
  background: #f5f1ea;
  color: #22302e;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
}

.page {
  min-height: 100vh;
  padding: 40rpx 32rpx 56rpx;
  box-sizing: border-box;
}

.brand {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 28rpx;
}

.brand-mark {
  width: 64rpx;
  height: 64rpx;
  border-radius: 18rpx;
  background: #17504e;
  color: #f3dcc8;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 600;
}

.brand-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #17504e;
}

.brand-sub {
  font-size: 22rpx;
  color: #7a8580;
  margin-top: 2rpx;
}

.hero {
  margin: 32rpx 0 28rpx;
}

.hero-title {
  font-size: 52rpx;
  line-height: 1.35;
  font-weight: 600;
  color: #17504e;
}

.hero-sub {
  margin-top: 14rpx;
  color: #66716b;
  line-height: 1.7;
  font-size: 26rpx;
}

.card {
  background: #fffdfa;
  border: 2rpx solid #e7dfd2;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(34, 48, 46, 0.04);
}

.label {
  font-size: 24rpx;
  color: #66716b;
  margin-bottom: 12rpx;
}

.textarea {
  width: 100%;
  min-height: 220rpx;
  background: #faf6ee;
  border-radius: 16rpx;
  padding: 20rpx;
  box-sizing: border-box;
  font-size: 30rpx;
  line-height: 1.7;
}

.counter {
  text-align: right;
  font-size: 22rpx;
  color: #8a938d;
  margin-top: 8rpx;
}

.row {
  display: flex;
  gap: 20rpx;
}

.row .card {
  flex: 1;
}

.picker {
  background: #faf6ee;
  border-radius: 14rpx;
  padding: 18rpx 20rpx;
  color: #22302e;
}

.input {
  background: #faf6ee;
  border-radius: 14rpx;
  padding: 18rpx 20rpx;
  height: 44rpx;
  color: #22302e;
}

.btn {
  margin-top: 28rpx;
  background: #bf6a34;
  color: #fff;
  border-radius: 999rpx;
  font-size: 32rpx;
  font-weight: 600;
  padding: 22rpx 0;
  border: none;
}

.btn::after {
  border: none;
}

.btn[disabled] {
  background: #d9c8b5;
  color: #fff;
}

.tip {
  margin-top: 24rpx;
  font-size: 22rpx;
  color: #8a938d;
  line-height: 1.7;
  text-align: center;
}

.btn-ghost {
  background: transparent;
  color: #17504e;
  border: 2rpx solid #c9dbd6;
  border-radius: 999rpx;
  font-size: 28rpx;
  padding: 16rpx 0;
  margin-top: 16rpx;
}

.btn-ghost::after {
  border: none;
}
