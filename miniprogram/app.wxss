page {
  background: #f4f7f6;
  color: #1d2a28;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
}

view,
text,
button,
input,
textarea,
scroll-view {
  box-sizing: border-box;
}

button {
  font-family: inherit;
}

button::after {
  border: none;
}

.page {
  min-height: 100vh;
  padding: 28rpx 28rpx 48rpx;
}

.card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 28rpx;
  box-shadow: 0 8rpx 30rpx rgba(23, 80, 78, 0.06);
}

.primary-btn {
  width: 100%;
  height: 92rpx;
  line-height: 92rpx;
  border-radius: 46rpx;
  background: #17504e;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 500;
  text-align: center;
  padding: 0;
  box-shadow: 0 10rpx 24rpx rgba(23, 80, 78, 0.18);
}

.primary-btn[disabled] {
  opacity: 0.55;
  box-shadow: none;
}

.muted {
  color: #7d8b86;
}

.mono {
  font-family: ui-monospace, Menlo, monospace;
}

.empty {
  padding: 80rpx 20rpx;
  text-align: center;
  color: #9aa7a2;
  font-size: 25rpx;
}
