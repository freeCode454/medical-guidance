.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 40;
  display: flex;
  height: calc(104rpx + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  background: rgba(255, 253, 249, 0.98);
  border-top: 1rpx solid #eee5d6;
}

.tabbar__item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  color: #9aa7a2;
  font-size: 20rpx;
}

.tabbar__item.is-on {
  color: #17504e;
  font-weight: 500;
}

.tabbar__icon {
  width: 46rpx;
  height: 46rpx;
}
