.home-chat {
  min-height: 100vh;
  padding: 28rpx 28rpx calc(300rpx + env(safe-area-inset-bottom));
  background:
    radial-gradient(500rpx 320rpx at 100% 0%, rgba(23, 80, 78, 0.08), transparent 70%),
    #f4f7f6;
}

.intro {
  padding: 10rpx 6rpx 28rpx;
}

.intro__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.intro__eyebrow {
  font-size: 20rpx;
  letter-spacing: 4rpx;
  color: #b5783f;
}

.avatar {
  width: 76rpx;
  height: 76rpx;
  flex: none;
  border-radius: 50%;
  background: #e3ede9;
  color: #17504e;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 600;
}

.intro__title {
  display: block;
  margin-top: 10rpx;
  font-size: 46rpx;
  line-height: 1.3;
  font-weight: 600;
  color: #17504e;
}

.intro__desc {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #7d8b86;
}

.welcome {
  padding: 26rpx;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 32rpx rgba(23, 80, 78, 0.06);
}

.welcome__head {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.welcome__badge {
  width: 58rpx;
  height: 58rpx;
  flex: none;
  border-radius: 18rpx;
  background: linear-gradient(145deg, #1d625e, #123f3d);
  color: #f6e2cf;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  font-weight: 600;
}

.welcome__name {
  flex: 1;
  font-size: 26rpx;
  font-weight: 600;
  color: #1d2a28;
}

.welcome__online {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 19rpx;
  color: #2f7d63;
}

.dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #3fa77f;
}

.welcome__bubble {
  margin-top: 18rpx;
  padding: 20rpx 22rpx;
  border-radius: 4rpx 20rpx 20rpx 20rpx;
  background: #f1f7f5;
  color: #52615b;
  font-size: 26rpx;
  line-height: 1.7;
}

.welcome__example {
  display: block;
  margin-top: 12rpx;
  padding-left: 8rpx;
  color: #aebbb6;
  font-size: 21rpx;
}

.composer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: calc(104rpx + env(safe-area-inset-bottom));
  z-index: 30;
  padding: 12rpx 24rpx 10rpx;
  background: #ffffff;
  border-top: 1rpx solid #eef0ea;
}

.input-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.chat-input {
  flex: 1;
  height: 76rpx;
  padding: 0 24rpx;
  border-radius: 38rpx;
  background: #f4f7f6;
  color: #1d2a28;
  font-size: 27rpx;
}

.placeholder {
  color: #aebbb6;
}

.send-btn {
  width: 20%;
  flex: 0 0 20%;
  height: 76rpx;
  padding: 0;
  border-radius: 38rpx;
  background: #2f6fed;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 500;
  box-shadow: 0 6rpx 16rpx rgba(47, 111, 237, 0.24);
}

.send-btn.is-disabled {
  background: #cfe0ff;
  box-shadow: none;
}

.send-btn--active {
  background: #1f5ed6;
}

.composer__note {
  display: block;
  margin-top: 8rpx;
  text-align: center;
  color: #b6c1bc;
  font-size: 18rpx;
}

.intro,
.welcome {
  margin-bottom: 20rpx;
}
