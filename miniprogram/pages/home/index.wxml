<view class="page home-page">
  <view class="steps">
    <view class="step active"><text class="step-no">1</text>描述不适</view>
    <view class="step-line"></view>
    <view class="step"><text class="step-no">2</text>智能追问</view>
    <view class="step-line"></view>
    <view class="step"><text class="step-no">3</text>分诊结果</view>
  </view>

  <view class="brand">
    <view class="brand-mark">诊</view>
    <view>
      <view class="brand-name">智能导诊</view>
      <view class="brand-sub">预问诊 · 分诊建议</view>
    </view>
  </view>

  <view class="hero">
    <view class="hero-title">哪里不舒服，</view>
    <view class="hero-title">先告诉它</view>
    <view class="hero-sub">描述越具体，分诊越准确。全程匿名，信息仅用于本次分诊建议。</view>
  </view>

  <view class="card">
    <view class="label">描述您的不适</view>
    <textarea
      class="textarea"
      value="{{complaint}}"
      maxlength="300"
      placeholder="例如：肚子疼三天了，还拉肚子，没有发烧"
      placeholder-class="placeholder"
      bindinput="onInput"
    />
    <view class="counter">{{complaint.length}}/300</view>

    <view class="quick-title">常见症状，点一下快速填入</view>
    <view class="quick-row">
      <view class="chip" data-value="头痛，一阵一阵的" bindtap="onQuick">头痛</view>
      <view class="chip" data-value="肚子疼，还拉肚子" bindtap="onQuick">肚子疼</view>
      <view class="chip" data-value="咳嗽，有点发热" bindtap="onQuick">咳嗽发热</view>
      <view class="chip" data-value="胸口疼，有点闷" bindtap="onQuick">胸闷心慌</view>
    </view>
  </view>

  <view class="row">
    <view class="card">
      <view class="label">性别（选填）</view>
      <picker range="{{genders}}" value="{{genderIndex}}" bindchange="onGender">
        <view class="picker">{{genders[genderIndex]}}</view>
      </picker>
    </view>
    <view class="card">
      <view class="label">年龄（选填）</view>
      <input class="input" type="number" value="{{age}}" placeholder="例如 30" bindinput="onAge" />
    </view>
  </view>

  <button class="btn" loading="{{loading}}" disabled="{{loading}}" bindtap="onStart">
    开始问诊
  </button>

  <view class="privacy">
    <text class="privacy-icon">锁</text>
    <text>匿名问诊 · 设备身份只存指纹 · 不收集姓名和手机号</text>
  </view>
  <view class="tip">本系统仅提供分诊建议，不构成医学诊断。急危重症请立即拨打 120。</view>
</view>

