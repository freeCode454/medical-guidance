<view class="home">
  <view class="greeting">
    <view class="greeting__text">
      <text class="greeting__eyebrow">AI 预问诊</text>
      <text class="greeting__title">你好，{{account}}</text>
      <text class="greeting__sub">今天身体哪里不舒服？</text>
    </view>
    <view class="avatar">{{initial}}</view>
  </view>

  <view class="assistant">
    <view class="assistant__head">
      <view class="assistant__badge">AI</view>
      <view class="assistant__info">
        <text class="assistant__name">智能导诊助手</text>
        <text class="assistant__sub">已连接院内知识库 · 仅提供分诊建议</text>
      </view>
      <view class="assistant__online">
        <text class="dot"></text>
        <text>在线</text>
      </view>
    </view>

    <view class="assistant__hello">
      您好，我是智能导诊助手。请用一句话描述不适，我会像门诊医生一样逐步了解情况。
    </view>

    <view class="input-wrap {{focused ? 'is-focus' : ''}}">
      <textarea
        class="input"
        value="{{complaint}}"
        maxlength="300"
        placeholder="描述症状，例如：肚子疼三天了，还拉肚子"
        placeholder-class="placeholder"
        auto-height
        bindinput="onInput"
        bindfocus="onFocus"
        bindblur="onBlur"
      />
      <text class="count">{{complaint.length}}/300</text>
    </view>

    <view class="quick">
      <text class="quick__label">常见症状</text>
      <view
        class="quick__chip"
        wx:for="{{quick}}"
        wx:key="label"
        data-text="{{item.text}}"
        bindtap="onQuick"
      >{{item.label}}</view>
    </view>

    <view class="consent" bindtap="toggleConsent">
      <view class="checkbox {{consent ? 'is-on' : ''}}">
        <text wx:if="{{consent}}">✓</text>
      </view>
      <text>允许医生调阅我的历史预问诊病历</text>
    </view>

    <view class="action-row">
      <button
        class="start-btn"
        hover-class="start-btn--active"
        loading="{{loading}}"
        disabled="{{loading}}"
        bindtap="onStart"
      >
        <text>开始问诊</text>
        <text class="start-btn__arrow">→</text>
      </button>
    </view>
  </view>

  <view class="section-head">
    <text>常用服务</text>
  </view>

  <view class="services">
    <view class="service" bindtap="goProfile">
      <view class="service__icon service__icon--green">
        <image src="/assets/icon-calendar.png" mode="aspectFit" />
      </view>
      <view class="service__body">
        <text class="service__name">预约记录</text>
        <text class="service__desc">查看挂号与就诊时间</text>
      </view>
      <text class="service__arrow">›</text>
    </view>
    <view class="service" bindtap="goProfile">
      <view class="service__icon service__icon--blue">
        <image src="/assets/icon-file.png" mode="aspectFit" />
      </view>
      <view class="service__body">
        <text class="service__name">历史病历</text>
        <text class="service__desc">查看既往预问诊记录</text>
      </view>
      <text class="service__arrow">›</text>
    </view>
    <view class="service" bindtap="goProfile">
      <view class="service__icon service__icon--amber">
        <image src="/assets/icon-user.png" mode="aspectFit" />
      </view>
      <view class="service__body">
        <text class="service__name">个人资料</text>
        <text class="service__desc">年龄、性别与账号信息</text>
      </view>
      <text class="service__arrow">›</text>
    </view>
  </view>

  <bottom-nav active="home" />
</view>
