.login-page {
  min-height: 100vh;
  padding: 72rpx 44rpx 48rpx;
  background:
    radial-gradient(600rpx 400rpx at 90% 0%, rgba(23, 80, 78, 0.1), transparent 70%),
    #f4f7f6;
}

.login-hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 44rpx;
}

.logo {
  width: 118rpx;
  height: 118rpx;
  border-radius: 32rpx;
  background: linear-gradient(150deg, #17504e, #0f3b39);
  color: #f3dcc8;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 54rpx;
  font-weight: 600;
  box-shadow: 0 18rpx 36rpx rgba(23, 80, 78, 0.22);
}

.login-title {
  margin-top: 22rpx;
  font-size: 44rpx;
  font-weight: 600;
  color: #17504e;
  letter-spacing: 4rpx;
}

.login-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #7d8b86;
  letter-spacing: 1rpx;
}

.login-card {
  background: #ffffff;
  border-radius: 32rpx;
  padding: 34rpx 30rpx 30rpx;
  box-shadow: 0 16rpx 48rpx rgba(23, 80, 78, 0.08);
}

.tabs {
  display: flex;
  gap: 8rpx;
  padding: 6rpx;
  background: #f6f1e8;
  border-radius: 18rpx;
  margin-bottom: 28rpx;
}

.tab {
  flex: 1;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  border-radius: 14rpx;
  color: #7d8b86;
  font-size: 26rpx;
}

.tab.is-on {
  background: #ffffff;
  color: #17504e;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(23, 80, 78, 0.08);
}

.field {
  margin-top: 22rpx;
}

.field-label {
  display: block;
  margin-bottom: 10rpx;
  font-size: 24rpx;
  color: #7d8b86;
}

.field-input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  border-radius: 18rpx;
  background: #f7f9f8;
  border: 1rpx solid #e8eeec;
  font-size: 28rpx;
  color: #1d2a28;
}

.placeholder {
  color: #aebbb6;
}

.password-row {
  position: relative;
}

.password-row .field-input {
  padding-right: 100rpx;
}

.eye {
  position: absolute;
  right: 22rpx;
  top: 0;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 22rpx;
  color: #7d8b86;
}

.primary-btn {
  margin-top: 32rpx;
}

.hint {
  margin-top: 22rpx;
  text-align: center;
  font-size: 21rpx;
  line-height: 1.7;
  color: #9aa7a2;
}

.login-foot {
  margin-top: 42rpx;
  text-align: center;
  font-size: 20rpx;
  color: #aebbb6;
}
