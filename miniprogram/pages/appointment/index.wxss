.appointment-page {
  min-height: 100vh;
  padding: 24rpx 26rpx calc(160rpx + env(safe-area-inset-bottom));
  background: #f4f7f6;
}

.dept-card {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 26rpx;
  border-radius: 28rpx;
  background: linear-gradient(145deg, #17504e, #0f3b39);
  color: #f7f2e8;
  box-shadow: 0 16rpx 36rpx rgba(23, 80, 78, 0.16);
}

.dept-card__icon {
  width: 72rpx;
  height: 72rpx;
  flex: none;
  border-radius: 22rpx;
  background: rgba(243, 220, 200, 0.16);
  border: 1rpx solid rgba(243, 220, 200, 0.34);
  color: #f3dcc8;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
}

.dept-card__text {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.dept-card__name {
  font-size: 34rpx;
  font-weight: 600;
}

.dept-card__sub {
  font-size: 21rpx;
  color: rgba(247, 242, 232, 0.66);
}

.date-scroll {
  white-space: nowrap;
  margin: 24rpx 0 20rpx;
}

.date {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 104rpx;
  height: 104rpx;
  margin-right: 14rpx;
  border-radius: 22rpx;
  border: 1rpx solid #e6ece9;
  background: #ffffff;
  color: #7d8b86;
}

.date.is-on {
  background: #17504e;
  border-color: #17504e;
  color: #ffffff;
  box-shadow: 0 8rpx 18rpx rgba(23, 80, 78, 0.18);
}

.date__week {
  font-size: 20rpx;
  opacity: 0.8;
}

.date__day {
  margin-top: 2rpx;
  font-size: 27rpx;
  font-weight: 500;
}

.doctor-group {
  margin-top: 20rpx;
}

.group-title {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 0 4rpx 12rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #1d2a28;
}

.group-title__hint {
  font-size: 20rpx;
  color: #9aa7a2;
  font-weight: 400;
}

.doctor {
  padding: 24rpx;
  margin-bottom: 16rpx;
  border-radius: 26rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(23, 80, 78, 0.04);
}

.doctor__head {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 18rpx;
}

.doctor__avatar {
  width: 64rpx;
  height: 64rpx;
  flex: none;
  border-radius: 20rpx;
  background: #e3ede9;
  color: #17504e;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 25rpx;
  font-weight: 600;
}

.doctor__info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 3rpx;
}

.doctor__name {
  font-size: 28rpx;
  font-weight: 500;
  color: #1d2a28;
}

.doctor__title {
  font-size: 21rpx;
  color: #7d8b86;
}

.doctor__specialty {
  margin-top: 3rpx;
  font-size: 20rpx;
  line-height: 1.55;
  color: #b5783f;
}

.doctor__tag {
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: #f8e9dc;
  color: #a86232;
  font-size: 20rpx;
}

.slots {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 10rpx;
}

.slot {
  padding: 10rpx 4rpx;
  border-radius: 14rpx;
  border: 1rpx solid #e6ece9;
  background: #f7f9f8;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 3rpx;
}

.slot.is-on {
  background: #17504e;
  border-color: #17504e;
}

.slot.is-off {
  opacity: 0.4;
}

.slot__time {
  font-size: 20rpx;
  color: #1d2a28;
}

.slot__left {
  font-size: 18rpx;
  color: #9aa7a2;
}

.slot.is-on .slot__time,
.slot.is-on .slot__left {
  color: #ffffff;
}

.my-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 30rpx 4rpx 12rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #1d2a28;
}

.my-head__count {
  font-size: 20rpx;
  font-weight: 400;
  color: #9aa7a2;
}

.my-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 22rpx;
  margin-bottom: 12rpx;
  border-radius: 22rpx;
  background: #ffffff;
}

.my-item__main {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 3rpx;
  min-width: 0;
}

.my-item__title {
  font-size: 25rpx;
  color: #1d2a28;
}

.my-item__time {
  font-size: 21rpx;
  color: #7d8b86;
}

.my-item__no {
  font-size: 18rpx;
  color: #aebbb6;
  font-family: ui-monospace, Menlo, monospace;
}

.my-item__side {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 6rpx;
}

.my-item__status {
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: #e3ede9;
  color: #17504e;
  font-size: 19rpx;
}

.my-item__status.is-off {
  background: #f2efe8;
  color: #9aa7a2;
}

.my-item__cancel {
  font-size: 20rpx;
  color: #b4432f;
}

.confirm-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 26rpx calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(255, 253, 249, 0.98);
  border-top: 1rpx solid #eee5d6;
}

.confirm-bar__text {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 3rpx;
  min-width: 0;
}

.confirm-bar__doctor {
  font-size: 25rpx;
  font-weight: 500;
  color: #1d2a28;
}

.confirm-bar__sub {
  font-size: 20rpx;
  color: #7d8b86;
}

.confirm-btn {
  flex: none;
  margin: 0;
  padding: 0 30rpx;
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 38rpx;
  background: #17504e;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 500;
}

.retry-btn {
  margin-top: 20rpx;
  height: 68rpx;
  line-height: 68rpx;
  border-radius: 34rpx;
  background: #17504e;
  color: #ffffff;
  font-size: 24rpx;
}

.empty-card {
  margin-top: 12rpx;
  padding: 50rpx 20rpx;
  border-radius: 24rpx;
  background: #ffffff;
  text-align: center;
  color: #9aa7a2;
  font-size: 23rpx;
}

.success-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 44rpx;
  background: rgba(18, 32, 30, 0.48);
}

.success-card {
  width: 100%;
  max-width: 600rpx;
  padding: 36rpx 30rpx 30rpx;
  border-radius: 32rpx;
  background: #ffffff;
  box-shadow: 0 24rpx 60rpx rgba(18, 32, 30, 0.24);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.success-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: #e3f2e9;
  color: #2f8a5f;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 42rpx;
  font-weight: 600;
}

.success-title {
  margin-top: 16rpx;
  font-size: 36rpx;
  font-weight: 600;
  color: #1d2a28;
}

.success-sub {
  margin-top: 4rpx;
  font-size: 21rpx;
  color: #8b9893;
}

.success-detail {
  width: 100%;
  margin-top: 26rpx;
  padding: 18rpx 20rpx;
  border-radius: 20rpx;
  background: #f7f9f8;
}

.success-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  padding: 9rpx 0;
}

.success-label {
  flex: none;
  width: 130rpx;
  font-size: 22rpx;
  color: #8b9893;
}

.success-value {
  flex: 1;
  text-align: right;
  font-size: 23rpx;
  line-height: 1.5;
  color: #1d2a28;
}

.success-value--mono {
  font-family: ui-monospace, Menlo, monospace;
  font-size: 20rpx;
  color: #52615b;
}

.success-value--status {
  color: #2f8a5f;
}

.success-tip {
  margin-top: 18rpx;
  text-align: center;
  font-size: 20rpx;
  line-height: 1.6;
  color: #aebbb6;
}

.success-btn {
  width: 100%;
  height: 82rpx;
  line-height: 82rpx;
  margin-top: 22rpx;
  padding: 0;
  border-radius: 41rpx;
  background: #17504e;
  color: #ffffff;
  font-size: 27rpx;
  font-weight: 500;
}
