.profile {
  min-height: 100vh;
  padding: 24rpx 28rpx calc(150rpx + env(safe-area-inset-bottom));
  background: #f4f7f6;
}

.user-card {
  background: linear-gradient(145deg, #17504e, #0f3b39);
  border-radius: 32rpx;
  padding: 30rpx;
  color: #f7f2e8;
  box-shadow: 0 18rpx 44rpx rgba(23, 80, 78, 0.18);
}

.user-card__top {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.avatar {
  width: 92rpx;
  height: 92rpx;
  flex: none;
  border-radius: 50%;
  background: rgba(243, 220, 200, 0.16);
  border: 1rpx solid rgba(243, 220, 200, 0.34);
  color: #f3dcc8;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 38rpx;
  font-weight: 600;
}

.user-card__info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.user-card__name {
  font-size: 38rpx;
  font-weight: 600;
}

.user-card__no {
  font-size: 21rpx;
  color: rgba(247, 242, 232, 0.64);
  font-family: ui-monospace, Menlo, monospace;
}

.facts {
  display: flex;
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(247, 242, 232, 0.16);
}

.fact {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.fact__label {
  font-size: 20rpx;
  color: rgba(247, 242, 232, 0.55);
}

.fact__value {
  font-size: 25rpx;
  color: #f7f2e8;
}

.stats {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}

.stat {
  flex: 1;
  padding: 22rpx 0;
  border-radius: 24rpx;
  background: #ffffff;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2rpx;
  box-shadow: 0 8rpx 22rpx rgba(23, 80, 78, 0.04);
}

.stat__num {
  font-size: 38rpx;
  font-weight: 600;
  color: #17504e;
}

.stat__label {
  font-size: 20rpx;
  color: #8b9893;
}

.section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 34rpx 6rpx 14rpx;
}

.section-head__title {
  font-size: 27rpx;
  font-weight: 600;
  color: #1d2a28;
}

.section-head__count {
  font-size: 21rpx;
  color: #9aa7a2;
}

.appointment {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 22rpx 24rpx;
  border-radius: 24rpx;
  background: #ffffff;
  margin-bottom: 14rpx;
  box-shadow: 0 8rpx 24rpx rgba(23, 80, 78, 0.04);
}

.appointment__main {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}

.appointment__title {
  font-size: 27rpx;
  font-weight: 500;
  color: #1d2a28;
}

.appointment__time {
  font-size: 23rpx;
  color: #6e7d77;
}

.appointment__no {
  font-size: 19rpx;
  color: #aebbb6;
  font-family: ui-monospace, Menlo, monospace;
}

.status {
  flex: none;
  padding: 5rpx 14rpx;
  border-radius: 999rpx;
  background: #e3ede9;
  color: #17504e;
  font-size: 20rpx;
}

.status.is-off {
  background: #f2efe8;
  color: #9aa7a2;
}

.record {
  padding: 24rpx;
  border-radius: 24rpx;
  background: #ffffff;
  margin-bottom: 14rpx;
  box-shadow: 0 8rpx 24rpx rgba(23, 80, 78, 0.04);
}

.record__top {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.record__dept {
  font-size: 27rpx;
  font-weight: 500;
  color: #1d2a28;
}

.record__date {
  font-size: 20rpx;
  color: #aebbb6;
}

.record__complaint {
  display: block;
  margin-top: 6rpx;
  font-size: 23rpx;
  color: #52615b;
}

.record__summary {
  display: -webkit-box;
  margin-top: 6rpx;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  font-size: 21rpx;
  line-height: 1.6;
  color: #8b9893;
}

.record__link {
  display: block;
  margin-top: 8rpx;
  font-size: 21rpx;
  color: #b5783f;
}

.empty-card {
  padding: 40rpx 20rpx;
  border-radius: 24rpx;
  background: #ffffff;
  text-align: center;
  color: #9aa7a2;
  font-size: 23rpx;
}

.logout-btn {
  margin-top: 34rpx;
  height: 86rpx;
  line-height: 86rpx;
  border-radius: 43rpx;
  background: #ffffff;
  color: #b4432f;
  font-size: 27rpx;
  border: 1rpx solid #f0dfd9;
}
