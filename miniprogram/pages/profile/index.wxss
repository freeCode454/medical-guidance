.profile {
  min-height: 100vh;
  padding: 24rpx 28rpx calc(150rpx + env(safe-area-inset-bottom));
  background: #f4f7f6;
}

.user-card {
  background: linear-gradient(145deg, #17504e, #0f3b39);
  border-radius: 32rpx;
  padding: 30rpx;
  color: #f7f2e8;
  box-shadow: 0 18rpx 44rpx rgba(23, 80, 78, 0.18);
}

.user-card__top {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.avatar {
  width: 92rpx;
  height: 92rpx;
  flex: none;
  border-radius: 50%;
  background: rgba(243, 220, 200, 0.16);
  border: 1rpx solid rgba(243, 220, 200, 0.34);
  color: #f3dcc8;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 38rpx;
  font-weight: 600;
}

.user-card__info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.user-card__edit {
  flex: none;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(243, 220, 200, 0.32);
  background: rgba(243, 220, 200, 0.1);
  color: #f3dcc8;
  font-size: 20rpx;
}

.user-card__name {
  font-size: 38rpx;
  font-weight: 600;
}

.user-card__no {
  font-size: 21rpx;
  color: rgba(247, 242, 232, 0.64);
  font-family: ui-monospace, Menlo, monospace;
}

.facts {
  display: flex;
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(247, 242, 232, 0.16);
}

.fact {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.fact__label {
  font-size: 20rpx;
  color: rgba(247, 242, 232, 0.55);
}

.fact__value {
  font-size: 25rpx;
  color: #f7f2e8;
}

.stats {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}

.stat {
  flex: 1;
  padding: 22rpx 0;
  border-radius: 24rpx;
  background: #ffffff;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2rpx;
  box-shadow: 0 8rpx 22rpx rgba(23, 80, 78, 0.04);
}

.stat__num {
  font-size: 38rpx;
  font-weight: 600;
  color: #17504e;
}

.stat__label {
  font-size: 20rpx;
  color: #8b9893;
}

.section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 34rpx 6rpx 14rpx;
}

.section-head__title {
  font-size: 27rpx;
  font-weight: 600;
  color: #1d2a28;
}

.section-head__count {
  font-size: 21rpx;
  color: #9aa7a2;
}

.appointment {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 22rpx 24rpx;
  border-radius: 24rpx;
  background: #ffffff;
  margin-bottom: 14rpx;
  box-shadow: 0 8rpx 24rpx rgba(23, 80, 78, 0.04);
}

.appointment:active {
  background: #faf8f3;
}

.appointment__right {
  flex: none;
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.appointment__arrow {
  color: #c8d3ce;
  font-size: 32rpx;
  line-height: 1;
}

.appointment__main {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}

.appointment__title {
  font-size: 27rpx;
  font-weight: 500;
  color: #1d2a28;
}

.appointment__time {
  font-size: 23rpx;
  color: #6e7d77;
}

.appointment__no {
  font-size: 19rpx;
  color: #aebbb6;
  font-family: ui-monospace, Menlo, monospace;
}

.status {
  flex: none;
  padding: 5rpx 14rpx;
  border-radius: 999rpx;
  background: #e3ede9;
  color: #17504e;
  font-size: 20rpx;
}

.status.is-off {
  background: #f2efe8;
  color: #9aa7a2;
}

.record {
  padding: 24rpx;
  border-radius: 24rpx;
  background: #ffffff;
  margin-bottom: 14rpx;
  box-shadow: 0 8rpx 24rpx rgba(23, 80, 78, 0.04);
}

.record__top {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.record__dept {
  font-size: 27rpx;
  font-weight: 500;
  color: #1d2a28;
}

.record__date {
  font-size: 20rpx;
  color: #aebbb6;
}

.record__complaint {
  display: block;
  margin-top: 6rpx;
  font-size: 23rpx;
  color: #52615b;
}

.record__summary {
  display: -webkit-box;
  margin-top: 6rpx;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  font-size: 21rpx;
  line-height: 1.6;
  color: #8b9893;
}

.record__link {
  display: block;
  margin-top: 8rpx;
  font-size: 21rpx;
  color: #b5783f;
}

.empty-card {
  padding: 40rpx 20rpx;
  border-radius: 24rpx;
  background: #ffffff;
  text-align: center;
  color: #9aa7a2;
  font-size: 23rpx;
}

.logout-btn {
  margin-top: 34rpx;
  height: 86rpx;
  line-height: 86rpx;
  border-radius: 43rpx;
  background: #ffffff;
  color: #b4432f;
  font-size: 27rpx;
  border: 1rpx solid #f0dfd9;
}

.retry-btn {
  margin-top: 20rpx;
  height: 68rpx;
  line-height: 68rpx;
  border-radius: 34rpx;
  background: #17504e;
  color: #ffffff;
  font-size: 24rpx;
}

.sheet-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  background: rgba(18, 32, 30, 0.48);
}

.sheet {
  width: 100%;
  padding: 18rpx 32rpx calc(30rpx + env(safe-area-inset-bottom));
  border-radius: 32rpx 32rpx 0 0;
  background: #ffffff;
}

.sheet__handle {
  width: 64rpx;
  height: 8rpx;
  margin: 0 auto 24rpx;
  border-radius: 4rpx;
  background: #e4eae7;
}

.sheet__title {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
  color: #1d2a28;
}

.sheet__sub {
  display: block;
  margin-top: 4rpx;
  font-size: 21rpx;
  color: #8b9893;
}

.sheet__label {
  display: block;
  margin-top: 26rpx;
  margin-bottom: 12rpx;
  font-size: 23rpx;
  color: #52615b;
}

.gender-options {
  display: flex;
  gap: 14rpx;
}

.gender-option {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 18rpx;
  border: 1rpx solid #e6ece9;
  background: #f7f9f8;
  text-align: center;
  color: #52615b;
  font-size: 27rpx;
}

.gender-option.is-on {
  background: #17504e;
  border-color: #17504e;
  color: #ffffff;
  font-weight: 500;
}

.age-input-wrap {
  display: flex;
  align-items: center;
  height: 80rpx;
  padding: 0 22rpx;
  border-radius: 18rpx;
  border: 1rpx solid #e6ece9;
  background: #f7f9f8;
}

.age-input {
  flex: 1;
  height: 80rpx;
  font-size: 28rpx;
  color: #1d2a28;
}

.age-unit {
  flex: none;
  font-size: 24rpx;
  color: #8b9893;
}

.sheet__save {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  margin-top: 30rpx;
  padding: 0;
  border-radius: 44rpx;
  background: #17504e;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 500;
}

.detail-card {
  width: calc(100% - 88rpx);
  margin-bottom: 50rpx;
  padding: 30rpx;
  border-radius: 30rpx;
  background: #ffffff;
  box-shadow: 0 24rpx 60rpx rgba(18, 32, 30, 0.24);
}

.detail-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 18rpx;
  border-bottom: 1rpx solid #f1eee7;
}

.detail-head__title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1d2a28;
}

.detail-head__close {
  color: #aebbb6;
  font-size: 40rpx;
  line-height: 1;
}

.detail-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #f6f2ea;
}

.detail-label {
  flex: none;
  width: 130rpx;
  font-size: 22rpx;
  color: #8b9893;
}

.detail-value {
  flex: 1;
  text-align: right;
  font-size: 24rpx;
  line-height: 1.5;
  color: #1d2a28;
}

.detail-value--mono {
  font-family: ui-monospace, Menlo, monospace;
  font-size: 20rpx;
  color: #52615b;
}

.detail-value--status {
  color: #2f8a5f;
}

.detail-cancel {
  width: 100%;
  height: 78rpx;
  line-height: 78rpx;
  margin-top: 22rpx;
  padding: 0;
  border-radius: 39rpx;
  background: #fff4f0;
  color: #b4432f;
  font-size: 25rpx;
  border: 1rpx solid #f2d8ce;
}

.detail-close {
  width: 100%;
  height: 78rpx;
  line-height: 78rpx;
  margin-top: 12rpx;
  padding: 0;
  border-radius: 39rpx;
  background: #17504e;
  color: #ffffff;
  font-size: 25rpx;
}
