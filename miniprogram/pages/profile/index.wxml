<view class="profile">
  <view wx:if="{{loading}}" class="empty">正在加载个人信息…</view>
  <view wx:elif="{{error}}" class="empty-card">
    <text>{{error}}</text>
    <button class="retry-btn" bindtap="load">重新加载</button>
  </view>

  <block wx:else>
    <view class="user-card">
      <view class="user-card__top">
        <view class="avatar">{{initial}}</view>
        <view class="user-card__info">
          <text class="user-card__name">{{profile.account}}</text>
          <text class="user-card__no">{{profile.patient_no || profile.patient_id}}</text>
        </view>
        <text class="user-card__edit" bindtap="openEdit">编辑</text>
      </view>

      <view class="facts">
        <view class="fact">
          <text class="fact__label">性别</text>
          <text class="fact__value">{{profile.gender_label}}</text>
        </view>
        <view class="fact">
          <text class="fact__label">年龄</text>
          <text class="fact__value">{{ageText}}</text>
        </view>
        <view class="fact">
          <text class="fact__label">建档时间</text>
          <text class="fact__value">{{createdText}}</text>
        </view>
      </view>
    </view>

    <view class="stats">
      <view class="stat">
        <text class="stat__num">{{profile.session_count}}</text>
        <text class="stat__label">问诊</text>
      </view>
      <view class="stat">
        <text class="stat__num">{{profile.appointment_count}}</text>
        <text class="stat__label">预约</text>
      </view>
      <view class="stat">
        <text class="stat__num">{{profile.record_count}}</text>
        <text class="stat__label">病历</text>
      </view>
    </view>

    <view class="section-head">
      <text class="section-head__title">挂号记录</text>
      <text class="section-head__count">{{appointments.length}} 条</text>
    </view>
    <view wx:if="{{!appointments.length}}" class="empty-card">还没有预约记录</view>
    <view
      class="appointment"
      wx:for="{{appointments}}"
      wx:key="appointment_id"
      data-id="{{item.appointment_id}}"
      bindtap="onAppointment"
    >
      <view class="appointment__main">
        <text class="appointment__title">{{item.dept_name}} · {{item.doctor_name}}</text>
        <text class="appointment__time">{{item.dateText}} {{item.time_slot}}</text>
        <text class="appointment__no">{{item.appointment_no}}</text>
      </view>
      <view class="appointment__right">
        <text class="status {{item.isDone ? 'is-off' : ''}}">{{item.status_label}}</text>
        <text class="appointment__arrow">›</text>
      </view>
    </view>

    <view class="section-head">
      <text class="section-head__title">历史病历</text>
      <text class="section-head__count">{{records.length}} 份</text>
    </view>
    <view wx:if="{{!records.length}}" class="empty-card">还没有生成过预问诊病历</view>
    <view
      class="record"
      wx:for="{{records}}"
      wx:key="record_id"
      data-id="{{item.session_id}}"
      data-date="{{item.dateText}}"
      bindtap="onRecord"
    >
      <view class="record__top">
        <text class="record__dept">{{item.dept_name || '预问诊'}}</text>
        <text class="record__date">{{item.dateText}}</text>
      </view>
      <text class="record__complaint">{{item.chief_complaint || '未记录主诉'}}</text>
      <text class="record__summary">{{item.summary}}</text>
      <text class="record__link">查看病历 ›</text>
    </view>

    <button class="logout-btn" bindtap="logout">退出登录</button>
  </block>

  <view wx:if="{{editing}}" class="sheet-mask" catchtouchmove="noop" bindtap="closeEdit">
    <view class="sheet" catchtap="noop">
      <view class="sheet__handle"></view>
      <text class="sheet__title">编辑基础资料</text>
      <text class="sheet__sub">性别和年龄会用于分诊科室匹配</text>

      <text class="sheet__label">性别</text>
      <view class="gender-options">
        <view
          class="gender-option {{editGenderIndex == index ? 'is-on' : ''}}"
          wx:for="{{genderOptions}}"
          wx:key="*this"
          data-index="{{index}}"
          bindtap="onEditGender"
        >{{item}}</view>
      </view>

      <text class="sheet__label">年龄</text>
      <view class="age-input-wrap">
        <input
          class="age-input"
          type="number"
          value="{{editAge}}"
          placeholder="请输入年龄"
          placeholder-class="placeholder"
          maxlength="3"
          bindinput="onEditAge"
        />
        <text class="age-unit">岁</text>
      </view>

      <button class="sheet__save" loading="{{saving}}" disabled="{{saving}}" bindtap="saveProfile">保存</button>
    </view>
  </view>

  <view wx:if="{{detail}}" class="sheet-mask" catchtouchmove="noop" bindtap="closeDetail">
    <view class="detail-card" catchtap="noop">
      <view class="detail-head">
        <text class="detail-head__title">预约详情</text>
        <text class="detail-head__close" bindtap="closeDetail">×</text>
      </view>

      <view class="detail-row">
        <text class="detail-label">预约单号</text>
        <text class="detail-value detail-value--mono">{{detail.appointment_no}}</text>
      </view>
      <view class="detail-row">
        <text class="detail-label">就诊科室</text>
        <text class="detail-value">{{detail.dept_name}}</text>
      </view>
      <view class="detail-row">
        <text class="detail-label">医生</text>
        <text class="detail-value">{{detail.doctor_name}}（{{detail.doctor_title}}）</text>
      </view>
      <view class="detail-row">
        <text class="detail-label">就诊日期</text>
        <text class="detail-value">{{detail.dateText}}</text>
      </view>
      <view class="detail-row">
        <text class="detail-label">就诊时段</text>
        <text class="detail-value">{{detail.time_slot}}</text>
      </view>
      <view class="detail-row">
        <text class="detail-label">预约状态</text>
        <text class="detail-value detail-value--status">{{detail.status_label}}</text>
      </view>
      <view class="detail-row">
        <text class="detail-label">预约时间</text>
        <text class="detail-value">{{detail.createText}}</text>
      </view>

      <button wx:if="{{detail.can_cancel}}" class="detail-cancel" loading="{{cancelling}}" disabled="{{cancelling}}" bindtap="cancelAppointment">取消预约</button>
      <button class="detail-close" bindtap="closeDetail">关闭</button>
    </view>
  </view>

  <bottom-nav active="profile" />
</view>
