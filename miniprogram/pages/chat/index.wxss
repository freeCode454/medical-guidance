page {
  height: 100%;
}

.chat-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f5f1ea;
  box-sizing: border-box;
}

.chat-scroll {
  flex: 1;
  padding: 28rpx 28rpx 20rpx;
  box-sizing: border-box;
}

.empty {
  padding: 120rpx 20rpx;
  text-align: center;
  color: #8a938d;
  font-size: 26rpx;
}

.msg {
  margin-bottom: 26rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.msg.patient {
  align-items: flex-end;
}

.role {
  font-size: 22rpx;
  color: #8a938d;
  margin-bottom: 8rpx;
  padding: 0 4rpx;
}

.bubble {
  max-width: 82%;
  padding: 18rpx 22rpx;
  border-radius: 20rpx;
  background: #fffdfa;
  border: 2rpx solid #e7dfd2;
  color: #22302e;
  font-size: 28rpx;
  line-height: 1.7;
  word-break: break-all;
  white-space: pre-wrap;
}

.msg.patient .bubble {
  background: #17504e;
  border-color: #17504e;
  color: #fff;
  border-top-right-radius: 6rpx;
}

.msg.ai .bubble {
  border-top-left-radius: 6rpx;
}

.composer {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 16rpx 24rpx;
  background: #fffdfa;
  border-top: 2rpx solid #e7dfd2;
}

.composer-input {
  flex: 1;
  height: 76rpx;
  line-height: 76rpx;
  background: #faf6ee;
  border-radius: 999rpx;
  padding: 0 26rpx;
  font-size: 28rpx;
}

.send {
  width: 120rpx;
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 999rpx;
  background: #bf6a34;
  color: #fff;
  font-size: 26rpx;
  padding: 0;
}

.send::after {
  border: none;
}

.result-btn {
  margin: 10rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
  background: #fffdfa;
  color: #17504e;
  border: 2rpx solid #c9dbd6;
  border-radius: 999rpx;
  font-size: 28rpx;
}

.result-btn::after {
  border: none;
}
