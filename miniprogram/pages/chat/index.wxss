page {
  height: 100%;
}

.chat-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f5f1ea;
  box-sizing: border-box;
}

.chat-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 30rpx;
  background: #fffdfa;
  border-bottom: 2rpx solid #e7dfd2;
}

.chat-status {
  display: flex;
  align-items: center;
  gap: 8rpx;
  color: #17504e;
  font-size: 24rpx;
  font-weight: 600;
}

.status-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #3f8a6f;
  box-shadow: 0 0 0 6rpx rgba(63, 138, 111, 0.12);
}

.chat-rounds {
  color: #8a938d;
  font-size: 22rpx;
}

.chat-scroll {
  flex: 1;
  padding: 26rpx 26rpx 20rpx;
  box-sizing: border-box;
}

.empty {
  padding: 120rpx 20rpx;
  text-align: center;
  color: #8a938d;
  font-size: 26rpx;
}

.msg {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  margin-bottom: 28rpx;
}

.msg.patient {
  flex-direction: row-reverse;
}

.avatar {
  width: 58rpx;
  height: 58rpx;
  flex: none;
  border-radius: 18rpx;
  background: #e6efec;
  border: 2rpx solid #c9dbd6;
  color: #17504e;
  font-size: 22rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.msg.patient .avatar {
  background: #f7e7d9;
  border-color: #e6cdb5;
  color: #a55726;
}

.msg-body {
  max-width: 78%;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.msg.patient .msg-body {
  align-items: flex-end;
}

.role {
  font-size: 21rpx;
  color: #8a938d;
  margin-bottom: 7rpx;
  padding: 0 4rpx;
}

.bubble {
  padding: 18rpx 22rpx;
  border-radius: 20rpx;
  background: #fffdfa;
  border: 2rpx solid #e7dfd2;
  color: #22302e;
  font-size: 28rpx;
  line-height: 1.7;
  word-break: break-all;
  white-space: pre-wrap;
}

.msg.ai .bubble {
  border-top-left-radius: 6rpx;
}

.msg.patient .bubble {
  background: #17504e;
  border-color: #17504e;
  color: #fff;
  border-top-right-radius: 6rpx;
}

.typing {
  color: #8a938d;
}

.composer {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 16rpx 24rpx;
  background: #fffdfa;
  border-top: 2rpx solid #e7dfd2;
}

.composer-input {
  flex: 1;
  height: 76rpx;
  line-height: 76rpx;
  background: #faf6ee;
  border-radius: 999rpx;
  padding: 0 26rpx;
  font-size: 28rpx;
}

.send {
  width: 120rpx;
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 999rpx;
  background: #bf6a34;
  color: #fff;
  font-size: 26rpx;
  padding: 0;
}

.send::after {
  border: none;
}

.result-btn {
  margin: 10rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
  background: #fffdfa;
  color: #17504e;
  border: 2rpx solid #c9dbd6;
  border-radius: 999rpx;
  font-size: 28rpx;
}

.result-btn::after {
  border: none;
}
