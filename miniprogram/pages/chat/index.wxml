<view class="chat-page">
  <view class="chat-top">
    <view class="assistant-row">
      <view class="ai-avatar">AI</view>
      <view class="assistant-meta">
        <text class="assistant-name">智能导诊助手</text>
        <view class="assistant-status">
          <text class="status-dot {{awaitingReply ? 'is-thinking' : ''}}"></text>
          <text>{{awaitingReply ? 'AI 正在思考…' : '正在了解您的症状'}}</text>
        </view>
      </view>
      <text wx:if="{{rounds}}" class="rounds">{{rounds}} 轮</text>
    </view>
  </view>

  <scroll-view
    class="chat-scroll"
    scroll-y
    scroll-top="{{scrollTop}}"
  >
    <view class="day-label">本次问诊</view>

    <view wx:if="{{loading}}" class="empty-tip">正在加载对话…</view>
    <view wx:elif="{{!messages.length}}" class="empty-tip">{{sessionId ? '正在准备第一个问题…' : '请描述身体不适，开始本次问诊'}}</view>

    <view
      wx:for="{{messages}}"
      wx:key="message_id"
      id="m{{index}}"
      class="msg {{item.isPatient ? 'msg--me' : 'msg--ai'}}"
    >
      <view class="msg-avatar">{{item.isPatient ? '我' : 'AI'}}</view>
      <view class="msg-body">
        <text class="msg-role">{{item.roleLabel}}</text>
        <view class="bubble">
          <text>{{item.content}}</text>
        </view>
      </view>
    </view>

    <view wx:if="{{awaitingReply}}" class="msg msg--ai">
      <view class="msg-avatar">AI</view>
      <view class="msg-body">
        <text class="msg-role">智能助手</text>
        <view class="bubble bubble--typing">
          <view class="typing-dots"><text class="typing-dot"></text><text class="typing-dot"></text><text class="typing-dot"></text></view>
          <text>正在思考</text>
        </view>
      </view>
    </view>

    <view class="scroll-bottom"></view>
  </scroll-view>

  <view class="composer">
    <view wx:if="{{hasTriage}}" class="result-banner" bindtap="onResult">
      <view class="result-banner__left">
        <text class="result-banner__dot"></text>
        <view>
          <text class="result-banner__title">分诊建议已生成</text>
          <text class="result-banner__sub">查看推荐科室与预问诊病历</text>
        </view>
      </view>
      <text class="result-banner__arrow">›</text>
    </view>

    <view class="input-row">
      <input
        class="chat-input"
        value="{{input}}"
        placeholder="说说您的感受…"
        placeholder-class="placeholder"
        confirm-type="send"
        adjust-position
        cursor-spacing="24"
        bindinput="onInput"
        bindconfirm="onSend"
      />
      <button
        class="send-btn {{sending || !input ? 'is-disabled' : ''}}"
        hover-class="send-btn--active"
        loading="{{sending}}"
        disabled="{{sending || !input}}"
        bindtap="onSend"
      >
        <text wx:if="{{!sending}}">发送</text>
      </button>
    </view>

    <text class="composer-note">内容仅用于本次问诊，医生可查看预问诊记录</text>
  </view>
</view>
