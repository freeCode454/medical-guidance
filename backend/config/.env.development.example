# 开发期配置示例
#
# 用法：复制为 .env 后填入自己的 API Key
#   cp config/.env.development.example .env
#
# 切换环境只改这几个值：
#   LLM_BASE_URL / EMBEDDING_BASE_URL / RERANK_BASE_URL / MILVUS_URI / DATABASE_URL

# ---------------- 部署形态与出域策略 ----------------
# DEPLOY_MODE：dev 开发形态 / prod 交付形态
#
# EGRESS_POLICY：出域策略，与部署形态**正交**，不随环境名称自动放宽（NFR70）
#   strict       —— 交付形态默认值。患者数据能力的目标地址在院外一律拒绝
#   dev_sandbox  —— 仅开发形态。放行内容生成 / 精排 / 知识库检索的院外调用，
#                   但必须同时满足四项约束：
#                     ① 只使用合成数据（patient_hash 以 DEV_ 开头）
#                     ② 每次放行写审计（action_type=EGRESS_DEV）
#                     ③ 界面与日志显式标注当前为开发形态
#                     ④ DEPLOY_MODE=prod 时不允许该取值（启动即失败）
DEPLOY_MODE=dev
EGRESS_POLICY=dev_sandbox
DEBUG_ENDPOINTS=true

# ---------------- 内容生成 ----------------
# 关键：选用与生产环境同一个开源模型的 API 版本，保证行为一致
# 生产环境将替换为本地推理服务，例如 http://vllm-svc.intranet:8000/v1
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_API_KEY=在此填入你的密钥
LLM_MODEL=Qwen/Qwen2.5-32B-Instruct
SMALL_LLM_MODEL=Qwen/Qwen2.5-7B-Instruct

# ---------------- 向量化 ----------------
# provider=local：本地 BGE-M3，一次推理同时产出稠密 + 稀疏向量（主力）
# provider=api  ：云端 BGE-M3，**只产出稠密向量**，混合检索会退化为纯语义检索
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL_PATH=D:/AIProject/models/bge-m3
EMBEDDING_BATCH_SIZE=8
EMBEDDING_MAX_LENGTH=512
EMBEDDING_SPARSE_TOP_K=256

# provider=api 时使用；留空表示与 LLM_BASE_URL 同网关
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3

# ---------------- 精排 ----------------
# 与向量化解耦：向量化可本地，精排可云端，二者互不影响
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_BASE_URL=
RERANK_API_KEY=
RERANK_ENABLED=true
# 开发期 CPU 不适合大量候选，先收敛；生产环境可放开到 20~30
RERANK_CANDIDATES=8

# ---------------- 存储 ----------------
# 向量库：Milvus Standalone（Milvus Lite 不支持 Windows），由 make vector-up 启动
MILVUS_URI=http://localhost:19530
# 关系库：PostgreSQL，由 deploy/docker-compose.infra.yml 启动（映射到 5440）
DATABASE_URL=postgresql+asyncpg://medguide:medguide@localhost:5440/medguide
# 缓存：db 0 业务缓存 / db 1 Celery broker / db 2 result backend
REDIS_URL=redis://localhost:6379/0

# ---------------- 编排检查点 ----------------
# postgres：挂起会话落库，服务重启/多 worker 后可恢复（交付必须）
# memory  ：仅单测/临时演示；DEPLOY_MODE=prod 时会拒绝启动
CHECKPOINT_BACKEND=postgres
# 留空表示复用 DATABASE_URL
CHECKPOINT_DATABASE_URL=
# 检查点连接池（1~20；长连接由 psycopg_pool 维护）
CHECKPOINT_POOL_MIN_SIZE=1
CHECKPOINT_POOL_MAX_SIZE=5

# ---------------- 对象存储（MinIO） ----------------
# 开发期若内存紧张可暂不启动 MinIO，文件先落本地目录；
# 表结构与接口不变，只影响对象实体存放位置。
OBJECT_STORAGE_ENDPOINT=localhost:9000
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin
OBJECT_STORAGE_BUCKET=medguide
OBJECT_STORAGE_SECURE=false

# ---------------- 敏感字段加密 ----------------
# 模型服务 API Key 以 Fernet（enc:v1:）密文落库；留空时从 JWT_SECRET 派生。
# 生产建议独立配置，便于与 JWT 密钥分别轮换；更换后旧密文将无法解密。
FIELD_ENCRYPTION_KEY=

# ---------------- 能力开关 ----------------
# 语音识别需本地模型，开发机不具备条件，开发期跳过，全流程用文字输入验证
ASR_ENABLED=false
TRACING_ENABLED=false
