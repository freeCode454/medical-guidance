# 统一换行符：仓库内文本一律 LF，避免 Windows CRLF 污染 diff 与 CI

# 文本文件按内容自动识别，检出时统一 LF
* text=auto

# 明确指定换行符的文本类型
*.py   text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.sh   text eol=lf
*.sql  text eol=lf
*.js   text eol=lf
*.ts   text eol=lf
*.vue  text eol=lf
*.css  text eol=lf
*.html text eol=lf
Makefile text eol=lf

# 二进制文件不做换行符转换
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.bin  binary
*.onnx binary
*.onnx_data binary
*.safetensors binary
*.db   binary
